# frontend の環境変数サンプル。実値は .env(git管理外)に書く。
#
# 開発中(Auth0未準備)は認証を無効化:
AUTH_DISABLED=true
#
# Auth0テナント準備後は AUTH_DISABLED=false にして以下を設定する。
# Auth0 の Application(Regular Web App)と API(audience)を作成して値を取得する。
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxxx
AUTH0_AUDIENCE=https://api.clinic-inventory
AUTH0_CALLBACK_URL=http://localhost:5173/auth/callback

# セッションCookie署名鍵。本番はランダムな長い値へ。
SESSION_SECRET=change-me-to-a-long-random-string

APP_BASE_URL=http://localhost:5173
