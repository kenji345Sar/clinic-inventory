# backend(Go cmd/api)の環境変数サンプル。実値は .env(git管理外)に書く。
# 起動は ./run.sh(この .env を読み込んで go run する)。

# DBの接続文字列。未設定なら main.go のデフォルト
#   host=localhost user=apple dbname=clinic_inventory port=5432 sslmode=disable
# が使われる。ローカルのユーザー名/DB名が違う場合だけ設定する。
# DATABASE_DSN=host=localhost user=apple dbname=clinic_inventory port=5432 sslmode=disable

# APIの待ち受けポート。未設定なら 8080。
# PORT=8080

# 認証。開発でAuth0を使わないときは true にすると JWT 検証を素通しする。
# フロントの .env の AUTH_DISABLED と揃えること(false同士 / true同士)。
AUTH_DISABLED=false

# AUTH_DISABLED=false のとき必須。フロントの .env と同じ Auth0 テナントの値。
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.clinic-inventory

# 発注CSVのアップロード先S3バケット。未設定なら clinic-inventory-orders-dev。
# 卸から届く商品マスタCSV(catalogs/配下)の読み取りは別リポジトリ
# (clinic-inventory-csv-functions)が担うため、backendはアップロードのみ。
# S3_BUCKET_ORDERS=clinic-inventory-orders-dev

# AWS認証情報・リージョンは標準のAWS環境変数(AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY等)で設定する。
# ローカルでLocalStack等のS3互換サービスを使う場合は AWS_ENDPOINT_URL_S3 でエンドポイントを上書きできる。
# AWS_REGION=ap-northeast-1
# AWS_ENDPOINT_URL_S3=http://localhost:4566
